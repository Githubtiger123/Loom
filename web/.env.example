# Optional local development proxy. Production serves /api on the same origin.
LOOM_API_PROXY_TARGET=http://127.0.0.1:8080
# TRUSTED-HEADER mode must be explicitly selected; default is local JWT login.
VITE_AUTH_MODE=local
# Exact independent HTTPS origin, matching backend auth.notebook_origin.
# Required for local-auth Notebook access. No trailing slash, path or secrets.
VITE_NOTEBOOK_ORIGIN=
