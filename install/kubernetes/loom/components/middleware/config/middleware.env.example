# 复制为 middleware.env 后填写；真实文件被 Git 和 Docker 构建上下文忽略。
# MYSQL_PASSWORD 必须与所选 overlay 的 config.local.yaml 中 db.dsn 密码一致。
# REDIS_PASSWORD 必须与 config.local.yaml 中 redis.password 一致。
MYSQL_ROOT_PASSWORD=REPLACE_ME_MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=loom
MYSQL_USER=loom
MYSQL_PASSWORD=REPLACE_ME_DB_PASSWORD
REDIS_PASSWORD=REPLACE_ME_REDIS_PASSWORD
