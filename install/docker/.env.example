# 复制为 .env。kubeconfig 必须是 flatten 后可在容器内独立使用的文件。
KUBECONFIG_PATH=./kubeconfig

MYSQL_PORT=3306
REDIS_PORT=6379
WEB_PORT=5173
API_PORT=8080

# 仅限本地开发；Kubernetes 环境在 overlay 的 config.local.yaml 中配置。
LOOM_AUTH_PUBLIC_ORIGIN=https://127.0.0.1:5173
LOOM_AUTH_SIGNING_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
