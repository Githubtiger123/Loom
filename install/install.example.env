# 复制为 install.local.env；脚本会自动读取。仅加载自己信任的本地文件。
# 此示例对应已装好 cert-manager / Istio、当前只继续安装 Profile 的集群。
# 所有值都允许同名环境变量覆盖；后续可把 INSTALL_NOTEBOOK 改成 true。
INSTALL_CERT_MANAGER="${INSTALL_CERT_MANAGER:-false}"
INSTALL_ISTIO="${INSTALL_ISTIO:-false}"
INSTALL_PROFILES="${INSTALL_PROFILES:-true}"
INSTALL_NOTEBOOK="${INSTALL_NOTEBOOK:-false}"

# 19 个镜像与 tag 统一维护在 manifests/registry/kustomization.yaml。
# 19 个均已由用户确认可拉；MinIO/mc 为 netvark 第三方来源，内容尚未核验。
# 当前公开镜像无需 Docker 登录或阿里云 imagePullSecret。
